# Application debug mode (true = verbose logging).
# WARNING: prints full messages in logs, may contain sensitive data.
APP_DEBUG=false

# Path to the SQLite database file.
ASSISTANT_BOT_DB_PATH=/data/assistantbot.db
# Key for encrypting the database. Change this to a long random secret.
ASSISTANT_BOT_DB_KEY=change-me-long-random-secret
# DeltaChat account storage (one account per bot instance).
DC_ACCOUNTS_PATH=/data/deltachat-accounts
# Optional: override path to deltachat-rpc-server binary.
# DELTACHAT_RPC_SERVER_COMMAND=deltachat-rpc-server
BOT_NAMES=bot,assistant
DAILY_SUMMARY_TIME=03:00
HTTP_TIMEOUT_SECONDS=30

# Optional Prometheus metrics HTTP server (empty = disabled). Example: :9090
# Metrics are exposed at http://<addr>/metrics
# For VictoriaMetrics scrape from the host, set ASSISTANT_BOT_METRICS_ADDR=:9090 and add under `bot`:
#   ports:
#     - "9090:9090"
ASSISTANT_BOT_METRICS_ADDR=

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL_DEFAULT=openai/gpt-oss-120b:free qwen/qwen3-next-80b-a3b-instruct:free nvidia/nemotron-3-super-120b-a12b:free
# Optional task-specific overrides. Each value can be one model or a fallback list (space and/or comma separated).
# Empty values fall back to LLM_MODEL_DEFAULT.
LLM_MODEL_REPLY=
LLM_MODEL_SUMMARY=
LLM_MODEL_TOPIC=
LLM_MODEL_PROFILE=
# Optional fine-grained overrides.
LLM_MODEL_TOPIC_UPDATE=
LLM_MODEL_TOPIC_REBUILD=
LLM_MODEL_PROFILE_UPDATE=
LLM_MODEL_PROFILE_REBUILD=
# Max output tokens fallback for all tasks.
LLM_MAX_COMPLETION_TOKENS=2048
# Task-specific max output tokens (optional). Empty values use the fallback above.
LLM_MAX_COMPLETION_TOKENS_REPLY=400
LLM_MAX_COMPLETION_TOKENS_SUMMARY=1200
LLM_MAX_COMPLETION_TOKENS_TOPIC=800
LLM_MAX_COMPLETION_TOKENS_PROFILE=700
# Optional fine-grained max token overrides.
LLM_MAX_COMPLETION_TOKENS_TOPIC_UPDATE=
LLM_MAX_COMPLETION_TOKENS_TOPIC_REBUILD=
LLM_MAX_COMPLETION_TOKENS_PROFILE_UPDATE=
LLM_MAX_COMPLETION_TOKENS_PROFILE_REBUILD=

# Optional MCP servers (JSON file, top-level key "mcpServers").
# ASSISTANT_BOT_MCP_SERVERS_FILE=/data/mcp-servers.json
# Supported per-server "type": "stdio", "streamable-http", "sse".
# Example (valid JSON — no trailing commas):
# {
#   "mcpServers": {
#     "weather": {
#       "type": "streamable-http",
#       "url": "http://mcp-weather:3000/mcp",
#       "headers": { "Authorization": "Bearer token" },
#       "system_prompt_append": "When calling weather tools, ask for the city if unknown; pass city names in English."
#     },
#     "local-tool": {
#       "type": "stdio",
#       "command": "python",
#       "args": ["/path/to/server.py"],
#       "env": { "API_KEY": "secret" }
#     }
#   }
# }
